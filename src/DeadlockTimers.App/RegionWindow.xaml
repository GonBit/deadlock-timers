<Window x:Class="DeadlockTimers.App.RegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeadlockTimers.App"
        mc:Ignorable="d"
        Title="OCR region"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#2200FF00"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Width="120"
        Height="40"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border BorderBrush="Red" BorderThickness="2">
        <TextBlock Text="OCR region — cover the match clock" Foreground="Red" FontSize="11"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="4" />
    </Border>
</Window>
